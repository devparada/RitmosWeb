---
import TarjetaComando from "../components/ui/TarjetaComando.astro";
import Plantilla from "../layouts/Plantilla.astro";
import Cabecera from "../components/secciones/Cabecera.astro";

const categorias = [
	{
		id: "reproduccion",
		titulo: "Reproducción",
		comandos: [
			{ titulo: "/play", descripcion: "Reproduce una canción, playlist o archivo adjunto.", ejemplo: "/play url:https://youtube.com/watch?v=..." },
			{ titulo: "/queue", descripcion: "Muestra la cola de reproducción actual.", ejemplo: "/queue" },
		],
	},
	{
		id: "control",
		titulo: "Control",
		comandos: [
			{ titulo: "/skip", descripcion: "Salta la canción que se está reproduciendo.", ejemplo: "/skip" },
			{ titulo: "/stop", descripcion: "Para la reproducción y desconecta al bot.", ejemplo: "/stop" },
			{ titulo: "/shuffle", descripcion: "Mezcla aleatoriamente las canciones de la cola actual.", ejemplo: "/shuffle" },
			{ titulo: "/loop", descripcion: "Activa o desactiva el modo repetición (canción o cola).", ejemplo: "/loop modo:queue" },
		],
	},
	{
		id: "playlists",
		titulo: "Playlists",
		comandos: [
			{ titulo: "/playlist create", descripcion: "Crea una nueva playlist en el servidor.", ejemplo: "/playlist create name:MiMusica" },
			{ titulo: "/playlist play", descripcion: "Reproduce una playlist existente.", ejemplo: "/playlist play name:MiMusica" },
			{ titulo: "/playlist add", descripcion: "Añade una canción a tu playlist.", ejemplo: "/playlist add playlist:MiMusica url:..." },
			{ titulo: "/playlist list", descripcion: "Muestra todas las playlists del servidor.", ejemplo: "/playlist list" },
			{ titulo: "/playlist delete", descripcion: "Elimina una canción específica de una playlist.", ejemplo: "/playlist delete playlist:MiMusica name:Cancion" },
			{ titulo: "/playlist remove", descripcion: "Elimina una playlist completa.", ejemplo: "/playlist remove name:MiMusica" },
		],
	},
	{
		id: "sistema",
		titulo: "Sistema",
		comandos: [
			{ titulo: "/leave", descripcion: "Desconecta el bot del canal de voz.", ejemplo: "/leave" },
			{ titulo: "/ping", descripcion: "Muestra la latencia del bot.", ejemplo: "/ping" },
		],
	},
];
---

<Plantilla titulo="Comandos | RitmosWeb" descripcion="Lista completa de comandos para usar RitmosBot en tu servidor de Discord.">
	<Cabecera />

	<main class="grow max-w-4xl mx-auto px-4 md:px-6 py-16 w-full" id="main-content">
		<header class="mb-12 animate-fade-in text-center">
			<h1 class="font-display font-extrabold text-4xl md:text-5xl mb-4 text-white tracking-tight">
				Comandos del Bot
			</h1>
			<p class="text-xl text-gray-300 max-w-2xl mx-auto">
				Controla la música de tu servidor con estos comandos, agrupados por categoría.
			</p>
		</header>

		<nav aria-label="Categorías de comandos" class="sticky top-16 z-40 -mx-4 md:-mx-6 px-4 md:px-6 py-3 mb-10 flex flex-wrap gap-2 bg-gray-950/80 backdrop-blur-md">
			{categorias.map((cat) => (
				<a
					href={'#' + cat.id}
					class="px-3 py-1.5 rounded-full border border-gray-800 text-sm text-gray-300 hover:border-violet-500/50 hover:text-white focus-visible:ring-2 focus-visible:ring-violet-500 outline-none"
				>
					{cat.titulo}
				</a>
			))}
		</nav>

		<div class="flex flex-col gap-14">
			{categorias.map((cat) => (
				<section id={cat.id} aria-labelledby={cat.id + '-title'} class="scroll-mt-32">
					<h2 id={cat.id + '-title'} class="font-display text-2xl font-bold text-white mb-5">
						{cat.titulo}
					</h2>
					<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
						{cat.comandos.map((comando) => (
							<TarjetaComando
								titulo={comando.titulo}
								descripcion={comando.descripcion}
								ejemplo={comando.ejemplo}
							/>
						))}
					</div>
				</section>
			))}
		</div>
	</main>
</Plantilla>
