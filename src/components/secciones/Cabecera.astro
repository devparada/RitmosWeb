---
import Boton from '../ui/Boton.astro';
import IconoMenuAbrir from '../../assets/menu-abrir.svg';
import IconoMenuCerrar from '../../assets/menu-cerrar.svg';

const enlaceDiscord = import.meta.env.PUBLIC_DISCORD_LINK;
---

<header class="border-b border-gray-800 bg-gray-950 sticky top-0 z-50">
  <div class="max-w-6xl mx-auto px-4 md:px-6 h-16 flex justify-between items-center relative">
    <a href="/" class="flex gap-3 items-center group" aria-label="Ir a la página de inicio">
      <img
        src="/favicon.png"
        alt="Logotipo de RitmosBot"
        class="w-9 h-9"
        loading="eager"
      />
      <span class="font-display font-bold text-xl tracking-tight text-white">RitmosBot</span>
    </a>

    <nav aria-label="Navegación Principal" class="hidden md:flex gap-8 items-center text-sm font-medium text-gray-300">
      <a href="/#funciones" class="underline decoration-transparent decoration-2 underline-offset-8 hover:decoration-violet-400 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-violet-500 rounded outline-none">Funciones</a>
      <a href="/comandos" class="underline decoration-transparent decoration-2 underline-offset-8 hover:decoration-violet-400 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-violet-500 rounded outline-none">Comandos</a>
      <a href="/#comoempezar" class="underline decoration-transparent decoration-2 underline-offset-8 hover:decoration-violet-400 hover:text-white transition-colors focus-visible:ring-2 focus-visible:ring-violet-500 rounded outline-none">Cómo empezar</a>
      
      <Boton 
        href={enlaceDiscord} 
        variant="primary" 
        target="_blank"
        ariaLabel="Invitar RitmosBot a tu servidor de Discord"
        class="px-5! py-2.5! rounded-full text-sm"
      >
        Invitar bot
      </Boton>
    </nav>
    
    <button 
      id="mobile-menu-btn" 
      class="md:hidden text-gray-300 hover:text-white p-2 focus-visible:ring-2 focus-visible:ring-violet-500 rounded outline-none"
      aria-expanded="false" 
      aria-label="Abrir menú de navegación"
      aria-controls="mobile-menu"
    >
      <img id="menu-icon-open" src={IconoMenuAbrir.src} alt="" class="w-7 h-7" />
      <img id="menu-icon-close" src={IconoMenuCerrar.src} alt="" class="w-7 h-7 hidden" />
    </button>
  </div>

  <div id="mobile-menu" class="hidden md:hidden border-t border-gray-800 bg-gray-900/95 backdrop-blur-md absolute w-full" aria-hidden="true">
    <nav class="flex flex-col px-4 py-6 gap-6 text-center font-medium">
      <a href="/#funciones" class="mobile-link text-gray-300 hover:text-white p-2">Funciones</a>
      <a href="/comandos" class="mobile-link text-gray-300 hover:text-white p-2">Comandos</a>
      <a href="/#comoempezar" class="mobile-link text-gray-300 hover:text-white p-2">Cómo empezar</a>
      
      <Boton 
        href={enlaceDiscord} 
        variant="primary" 
        target="_blank"
        class="rounded-full py-3! mx-auto mt-2 w-full max-w-xs"
      >
        Invitar bot
      </Boton>
    </nav>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const iconOpen = document.getElementById('menu-icon-open');
  const iconClose = document.getElementById('menu-icon-close');
  const links = document.querySelectorAll('.mobile-link');

  if(btn && menu) {
    btn.addEventListener('click', () => {
      const isExpanded = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!isExpanded));
      menu.classList.toggle('hidden');
      menu.setAttribute('aria-hidden', String(isExpanded));
      iconOpen?.classList.toggle('hidden');
      iconClose?.classList.toggle('hidden');
    });

    links.forEach(link => {
      link.addEventListener('click', () => {
        btn.setAttribute('aria-expanded', 'false');
        menu.classList.add('hidden');
        menu.setAttribute('aria-hidden', 'true');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
      });
    });
  }
</script>
