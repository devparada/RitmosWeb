---
interface Props {
  number: string | number;
  title: string;
  description: string;
  isLast?: boolean;
}

const { number, title, description, isLast = false } = Astro.props;
---

<li class="relative flex gap-6 items-start">
  <div class="shrink-0 w-12 h-12 bg-violet-600 text-white rounded-full flex items-center justify-center font-bold text-lg" aria-hidden="true">
    {number}
  </div>

  <div class="pt-2">
    <h3 class="text-xl font-bold text-white mb-2">{title}</h3>
    <p class="text-gray-400 leading-relaxed" set:html={description}></p>
  </div>

  {!isLast && (
    <span class="absolute left-6 top-14 h-[calc(100%-2rem)] w-px bg-gray-800" aria-hidden="true"></span>
  )}
</li>
