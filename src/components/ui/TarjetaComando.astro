---
interface Props {
    titulo: string;
    descripcion: string;
    ejemplo: string;
}

const { titulo, descripcion, ejemplo } = Astro.props;
---

<article class="bg-gray-900/80 border border-gray-800 rounded-2xl p-6 hover:border-gray-700 transition-colors w-full relative group has-[:focus-visible]:ring-2 has-[:focus-visible]:ring-violet-500">
    <h3 class="text-xl font-bold text-white font-mono mb-3">{titulo}</h3>

    <p class="text-gray-400 mb-5 leading-relaxed">
        {descripcion}
    </p>

    <div class="bg-gray-950 p-3 rounded-xl border border-gray-800 text-sm flex gap-2">
        <span class="text-gray-400 shrink-0 select-none" aria-hidden="true">Uso:</span>
        <code class="text-violet-300 font-mono wrap-anywhere">{ejemplo}</code>
    </div>
</article>
