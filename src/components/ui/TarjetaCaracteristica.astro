---
interface Props {
  title: string;
  description: string;
  wide?: boolean;
}

const { title, description, wide = false } = Astro.props;
---

<article
  class:list={[
    "bg-gray-900/50 border border-gray-800 p-8 rounded-2xl hover:border-violet-500/50 transition-colors group",
    wide && "md:col-span-2"
  ]}
>
  <div class="flex items-center gap-4 mb-4">
    <div class="shrink-0 text-violet-400" aria-hidden="true">
      <slot />
    </div>
    <h3 class="text-xl font-bold text-white">{title}</h3>
  </div>

  <p class="text-gray-400 leading-relaxed" class:list={[wide && "max-w-2xl"]}>
    {description}
  </p>
</article>
